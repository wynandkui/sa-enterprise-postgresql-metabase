# Copy to .env and replace placeholders; NEVER commit .env.
# Original deployment used PostgreSQL on the Raspberry Pi host.
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase_app
MB_DB_PORT=5432
MB_DB_HOST=127.0.0.1
MB_DB_USER=metabase_app_user
MB_DB_PASS=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MB_JETTY_HOST=0.0.0.0
MB_JETTY_PORT=3001
# JVM tuning is installation-dependent; set only after checking available RAM.
JAVA_TOOL_OPTIONS=REPLACE_WITH_REVIEWED_JVM_OPTIONS
# Generate fresh independent secrets; never reuse production keys in a public example.
MB_ENCRYPTION_SECRET_KEY=REPLACE_WITH_FRESH_RANDOM_ENCRYPTION_KEY
MB_SESSION_SECRET_KEY=REPLACE_WITH_FRESH_RANDOM_SESSION_KEY
